; Engine configuration file.
; APAS: BREACH — GTA3-Style 3D Narrative Game

config_version=5

[application]

config/name="APAS: BREACH"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
run/main_scene="res://scenes/title_screen.tscn"

[autoload]

Simulation="*res://scripts/simulation.gd"
HHI="*res://scripts/hhi.gd"
GameState="*res://scripts/game_state.gd"
AudioEngine="*res://autoloads/audio_engine.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
scaling_3d/scale=0.5
scaling_3d/mode=0
shading/overrides/force_vertex_shading=true
